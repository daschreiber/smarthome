# Copy to .env.local for development. Never commit real values.

# Home Assistant base URL. LAN during development; Nabu Casa URL at Phase D.
HA_BASE_URL=http://10.0.0.69:8123

# Long-lived access token of the dedicated `smarthome-app` HA user.
HA_TOKEN=

# Sign-in. APP_USERS seeds the user store ONCE when it is empty (first entry
# becomes admin); after that, manage users in the app's Users screen.
# APP_USERS=daniel@example.com:strongpass,daniella@example.com:strongpass
# APP_SESSION_SECRET=<long random string, e.g. `openssl rand -hex 32`>

# Where the user store lives (JSON). Point at a persistent volume in
# production, e.g. /data/users.json on Railway.
# USERS_PATH=./users.json

# Password-reset emails (optional). Without a key, admins hand out reset
# links from the Users screen instead.
# RESEND_API_KEY=
# EMAIL_FROM=Home <home@yourdomain.com>
# APP_BASE_URL=https://your-app.up.railway.app

# Legacy slice gate, still honored if set (sent via x-app-key header).
APP_KEY=

# Where per-user favorites are stored (JSON).
# FAVORITES_PATH=./favorites.json

# Where captured scenes and automations are stored (JSON; use the volume in
# production, e.g. /data/scenes.json and /data/automations.json).
# SCENES_PATH=./scenes.json
# AUTOMATIONS_PATH=./automations.json

# House timezone for automation schedules (IANA name). Defaults to the
# server's timezone — set explicitly on cloud hosts, which run UTC.
# APP_TZ=Asia/Jerusalem

# Where the command audit log (JSON lines) is written.
AUDIT_LOG_PATH=./audit.log

# Path to the generated entity map (defaults to ../data/entity_map.json).
# ENTITY_MAP_PATH=

# KLAFS sauna service (github.com/daschreiber/sauna, wherever deployed). When both
# set, the sauna appears as a virtual device; commands require confirm:true.
# SAUNA_BASE_URL=<the URL you open to control the sauna, Railway or Vercel>
# SAUNA_API_TOKEN=
