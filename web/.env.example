# Copy to .env.local for development. Never commit real values.

# Home Assistant base URL. LAN during development; Nabu Casa URL at Phase D.
HA_BASE_URL=http://10.0.0.69:8123

# Long-lived access token of the dedicated `smarthome-app` HA user.
HA_TOKEN=

# Sign-in. APP_USERS seeds the user store ONCE when it is empty (first entry
# becomes admin); after that, manage users in the app's Users screen.
# APP_USERS=daniel@example.com:strongpass,daniella@example.com:strongpass
# APP_SESSION_SECRET=<long random string, e.g. `openssl rand -hex 32`>

# Where the user store lives (JSON). Point at a persistent volume in
# production, e.g. /data/users.json on Railway.
# USERS_PATH=./users.json

# Password-reset emails (optional). Without a key, admins hand out reset
# links from the Users screen instead.
# RESEND_API_KEY=
# EMAIL_FROM=Home <home@yourdomain.com>
# APP_BASE_URL=https://your-app.up.railway.app

# Legacy slice gate, still honored if set (sent via x-app-key header).
APP_KEY=

# Where per-user favorites are stored (JSON).
# FAVORITES_PATH=./favorites.json

# Where captured scenes and automations are stored (JSON; use the volume in
# production, e.g. /data/scenes.json and /data/automations.json).
# SCENES_PATH=./scenes.json
# AUTOMATIONS_PATH=./automations.json

# House timezone for automation schedules (IANA name). Defaults to the
# server's timezone — set explicitly on cloud hosts, which run UTC.
# APP_TZ=Asia/Jerusalem

# Where the command audit log (JSON lines) is written.
AUDIT_LOG_PATH=./audit.log

# Path to the generated entity map (defaults to ../data/entity_map.json).
# ENTITY_MAP_PATH=

# KLAFS sauna service (github.com/daschreiber/sauna, wherever deployed). When both
# set, the sauna appears as a virtual device; commands require confirm:true.
# SAUNA_BASE_URL=<the URL you open to control the sauna, Railway or Vercel>
# SAUNA_API_TOKEN=

# White-noise machine (github.com/daschreiber/whitenoise, its own Railway
# service). When both are set, the "White noise" card appears in the Master
# Bedroom → Media group; the app controls sound type + volume, and on/off
# drives the room's Control4 zone via Home Assistant.
# WHITENOISE_BASE_URL=<the white-noise service's URL, e.g. Railway>
# WHITENOISE_TOKEN=<the white-noise service's SECRET_TOKEN>
# Optional — HA media_player entity told to play/stop the stream for in-app
# on/off. Defaults to media_player.master_bedroom.
# WHITENOISE_MEDIA_ENTITY=media_player.master_bedroom
# Optional — Control4 rooms JOIN sources instead of playing URLs (play_media
# is a no-op on the Control4 integration). If the stream is programmed into
# Control4 as a source, set its exact name (as it appears in the entity's
# source_list) and "on" becomes select_source on the room.
# WHITENOISE_MEDIA_SOURCE=White Noise

# Sleep watcher (lib/sleepwatch): auto white-noise when the Master Bedroom
# looks asleep, 22:00-08:00. State file — use the volume in production,
# e.g. /data/sleepwatch.json on Railway.
# SLEEPWATCH_PATH=./sleepwatch.json
# Relay state of the TV lift that means "stowed for sleep" (default off);
# set to "on" if the relay polarity turns out inverted. Also drives the TV
# follower (lib/liftwatch), whose "lift down" is the other state — one
# knob, so the two rules can never disagree.
# SLEEPWATCH_LIFT_STATE=off

# TV follower (lib/liftwatch): the MBR TV mirrors the ceiling lift's edges
# (down → on, up → off). State file — use the volume in production,
# e.g. /data/liftwatch.json on Railway.
# LIFTWATCH_PATH=./liftwatch.json
# Where the OFF goes (default: the Samsung itself, the only path proven to
# reach it). media_player.master_bedroom = Control4 Room Off — only
# meaningful once the ON also goes through Control4.
# LIFTWATCH_OFF_ENTITY=media_player.55_qled
# Off commands per stow (1-3, default 1). A power key is a toggle, so the
# follower never retries blind until the TV is proven to honor one off;
# 3 brings back the "still reads on → send again" enforcement.
# LIFTWATCH_OFF_ATTEMPTS=1

# White-noise control rides through HA (rest_command + status sensor on the
# Green) instead of the direct WHITENOISE_BASE_URL/TOKEN pair. Set to 1 in
# production; WHITENOISE_STREAM_URL is the add-on's LAN stream URL
# (incl. token) that the media player is told to play.
# WHITENOISE_VIA_HA=1
# WHITENOISE_STREAM_URL=http://10.0.0.69:8099/stream?token=...

# Shade positions are real (native KNX covers) — the UI trusts and shows
# them. Set to 1; see knx/README.md item 8.
# COVER_STATE_TRUSTED=1

# Away switch state file (use the volume in production).
# AWAY_PATH=./away.json

# Sauna follower watcher: state file, plus the Master Bathroom A/C target
# (default 18) and fan mode (default high) while the sauna heats.
# SAUNAWATCH_PATH=./saunawatch.json
# SAUNA_AC_TEMP=18
# SAUNA_AC_FAN=high

# Eight Sleep bed (docs/EIGHT_SLEEP_SETUP.md). A side configured = a bed
# card side in the app. Targets are number.* entities; presence is
# display-only.
# EIGHTSLEEP_LEFT_TARGET_ENTITY=number.left_bed_temperature
# EIGHTSLEEP_RIGHT_TARGET_ENTITY=number.right_bed_temperature
# EIGHTSLEEP_LEFT_PRESENCE_ENTITY=binary_sensor.left_bed_presence
# EIGHTSLEEP_RIGHT_PRESENCE_ENTITY=binary_sensor.right_bed_presence
# EIGHTSLEEP_LEFT_LABEL=Daniel's side
# EIGHTSLEEP_RIGHT_LABEL=Daniella's side
# EIGHTSLEEP_HEAT_DURATION_SECONDS=28800

# Spotify: OAuth app credentials (More → Spotify links accounts), the token
# stores, and an optional fallback context Play uses when nothing is paused.
# Put both stores on the persistent volume in production.
#   TOKEN_PATH  the shared house account (admin links it; the fallback for
#               anyone who hasn't connected their own)
#   LINKS_PATH  per-user links, so each person's Play/Pause/Skip drives
#               THEIR Spotify. Spotify's Development Mode allows five
#               authorised users per app (Feb 2026), and controlling
#               speakers needs Premium on each account.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_TOKEN_PATH=./spotify_token.json
# SPOTIFY_LINKS_PATH=./spotify_links.json
# SPOTIFY_DEFAULT_CONTEXT=spotify:playlist:...

# Multi-room "extend": the matrix input that carries the Control4 Core's own
# streamer, if one of the unidentified "Unknown Device - 42949662xx" inputs
# turns out to be it. Setting this lets a Core Spotify session be extended
# into other rooms; without it, extend covers named inputs only
# (docs/AUDIO_SYSTEM.md).
# SPOTIFY_MIRROR_SOURCE=Unknown Device - 4294966271

# "Ask the house" assistant (optional; the chat screen degrades gracefully).
# ANTHROPIC_API_KEY=

# Google sign-in (optional). Google only proves identity; the email must
# still be on the app's user list.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# User-assigned Roborock segment names (volume in production).
# VACUUM_ROOMS_PATH=./vacuum_rooms.json

# Auto-off timer rules (volume in production).
# TIMERS_PATH=./timers.json
